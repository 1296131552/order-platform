<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.company.order.visual</groupId>
        <artifactId>order-platform-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>order-platform-api</artifactId>
    <packaging>jar</packaging>

    <name>Order Platform API</name>
    <description>订单可视化平台 - API启动模块</description>

    <dependencies>
        <!-- Common Module -->
        <dependency>
            <groupId>com.company.order.visual</groupId>
            <artifactId>order-platform-common</artifactId>
        </dependency>

        <!-- Order Module -->
        <dependency>
            <groupId>com.company.order.visual</groupId>
            <artifactId>order-platform-order</artifactId>
        </dependency>

        <!-- Shipment Module -->
        <dependency>
            <groupId>com.company.order.visual</groupId>
            <artifactId>order-platform-shipment</artifactId>
        </dependency>

        <!-- Partner Module -->
        <dependency>
            <groupId>com.company.order.visual</groupId>
            <artifactId>order-platform-partner</artifactId>
        </dependency>

        <!-- Dashboard Module -->
        <dependency>
            <groupId>com.company.order.visual</groupId>
            <artifactId>order-platform-dashboard</artifactId>
        </dependency>

        <!-- Attachment Module -->
        <dependency>
            <groupId>com.company.order.visual</groupId>
            <artifactId>order-platform-attachment</artifactId>
        </dependency>

        <!-- Exception Module -->
        <dependency>
            <groupId>com.company.order.visual</groupId>
            <artifactId>order-platform-exception</artifactId>
        </dependency>

        <!-- User Module -->
        <dependency>
            <groupId>com.company.order.visual</groupId>
            <artifactId>order-platform-user</artifactId>
        </dependency>

        <!-- Visualization Module -->
        <dependency>
            <groupId>com.company.order.visual</groupId>
            <artifactId>order-platform-visualization</artifactId>
        </dependency>

        <!-- MySQL Driver -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Spring Boot Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>

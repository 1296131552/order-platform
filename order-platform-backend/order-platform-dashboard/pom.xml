<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.company.order.visual</groupId>
        <artifactId>order-platform-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>order-platform-dashboard</artifactId>
    <packaging>jar</packaging>

    <name>Order Platform Dashboard</name>
    <description>订单可视化平台 - 看板聚合模块</description>

    <dependencies>
        <!-- Common Module -->
        <dependency>
            <groupId>com.company.order.visual</groupId>
            <artifactId>order-platform-common</artifactId>
        </dependency>

        <!-- Order Module (for KPI calculation) -->
        <dependency>
            <groupId>com.company.order.visual</groupId>
            <artifactId>order-platform-order</artifactId>
        </dependency>

        <!-- Shipment Module (for KPI calculation) -->
        <dependency>
            <groupId>com.company.order.visual</groupId>
            <artifactId>order-platform-shipment</artifactId>
        </dependency>

        <!-- Partner Module (for KPI calculation) -->
        <dependency>
            <groupId>com.company.order.visual</groupId>
            <artifactId>order-platform-partner</artifactId>
        </dependency>

        <!-- MyBatis-Plus -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
